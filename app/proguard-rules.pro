# kotlinx.serialization: keep generated serializers for @Serializable models (domain + app).
-keepattributes *Annotation*, InnerClasses
-dontnote kotlinx.serialization.**
-keepclassmembers class kotlinx.serialization.json.** { *** Companion; }
-keepclasseswithmembers class kotlinx.serialization.json.** { kotlinx.serialization.KSerializer serializer(...); }
-keep,includedescriptorclasses class com.replypilot.**$$serializer { *; }
-keepclassmembers class com.replypilot.** { *** Companion; }
-keepclasseswithmembers class com.replypilot.** { kotlinx.serialization.KSerializer serializer(...); }

# Anthropic Java SDK (Jackson + OkHttp) is reflection-heavy; keep it intact in release builds.
-keep class com.anthropic.** { *; }
-keep class com.fasterxml.jackson.** { *; }
-dontwarn com.fasterxml.jackson.**
-dontwarn okhttp3.**
-dontwarn org.slf4j.**
-dontwarn java.lang.management.**

# Generated by R8: optional reflection/JSON-schema helpers in the SDK's dependencies that ReplyPilot doesn't use.
-dontwarn java.lang.reflect.AnnotatedParameterizedType
-dontwarn java.lang.reflect.AnnotatedType
